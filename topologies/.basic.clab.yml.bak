name: basic

topology:
  defaults:
    kind: linux
    image: ghcr.io/hellt/network-multitool

  nodes:
    host1:
      exec:
        - ip addr add 10.0.1.10/24 dev eth1
        - ip route add 10.0.0.0/8 via 10.0.1.1

    r1:
      sysctls:
        net.ipv4.ip_forward: 1
      exec:
        - ip addr add 10.0.1.1/24 dev eth1
        - ip addr add 10.0.12.1/24 dev eth2
        - ip route add 10.0.2.0/24 via 10.0.12.2

    r2:
      sysctls:
        net.ipv4.ip_forward: 1
      exec:
        - ip addr add 10.0.12.2/24 dev eth1
        - ip addr add 10.0.2.1/24 dev eth2
        - ip route add 10.0.1.0/24 via 10.0.12.1

    host2:
      exec:
        - ip addr add 10.0.2.10/24 dev eth1
        - ip route add 10.0.0.0/8 via 10.0.2.1

  links:
    - endpoints: ["host1:eth1", "r1:eth1"]
    - endpoints: ["r1:eth2", "r2:eth1"]
    - endpoints: ["r2:eth2", "host2:eth1"]
